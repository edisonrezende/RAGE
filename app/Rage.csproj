<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AssemblyName>RAGE</AssemblyName>
    <RootNamespace>Rage</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>rage.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>RAGE!</Product>
    <AssemblyTitle>RAGE!</AssemblyTitle>
    <Description>RAGE! - monitor, limpeza, otimizacao e modo turbo para jogos</Description>
    <Company>RAGE!</Company>
    <Copyright>RAGE! 2026</Copyright>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <DebugType>embedded</DebugType>
    <!-- Os símbolos embutidos guardam o caminho dos fontes; troca a pasta de quem compilou por "app" -->
    <PathMap>$(MSBuildProjectDirectory)=app</PathMap>
    <NoWarn>$(NoWarn);CS1591;CA1416;NU1701;MSB3270</NoWarn>
    <WebView2LoaderPreference>Static</WebView2LoaderPreference>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Management" />
    <Reference Include="System.ServiceProcess" />
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <!-- Permite compilar sem uma das pastas de modulos (usado durante o desenvolvimento em paralelo) -->
  <ItemGroup Condition="'$(SkipCare)' == 'true'">
    <Compile Remove="Care\**" />
  </ItemGroup>
  <ItemGroup Condition="'$(SkipTools)' == 'true'">
    <Compile Remove="Tools\**" />
  </ItemGroup>

  <!-- Interface (ui/dist) embutida no executavel -->
  <ItemGroup Condition="Exists('..\ui\dist\index.html')">
    <EmbeddedResource Include="..\ui\dist\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
